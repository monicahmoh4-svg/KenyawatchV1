# KenyaWatch AI Backend — Environment Variables
# Copy this file to `.env` and fill in your real values.
#   cp .env.example .env

# --- Required ---
# PostgreSQL connection string (Render provides this automatically via the
# DATABASE_URL env var when you use the managed database in render.yaml).
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/kenyawatch?sslmode=require

# --- Optional but recommended ---
# Google Gemini API key — enables the AI Investigator chat (/api/ai/chat).
# Without it, the AI chat returns a friendly "not configured" fallback.
GEMINI_API_KEY=

# Google Maps Static API key — used for high-res satellite imagery of ghost
# projects. Without it, the backend falls back to a free ArcGIS World Imagery
# tile source (no key required).
GOOGLE_MAPS_API_KEY=

# --- Optional tuning ---
# Comma-separated list of allowed CORS origins. Defaults to '*' (all origins).
# Example: ALLOWED_ORIGINS=https://kenyawatch.vercel.app,https://example.com
ALLOWED_ORIGINS=*

# Port the backend listens on. Render injects PORT automatically; default 5000.
PORT=5000

# Admin API key. If set, the protected POST /api/admin/reseed endpoint requires
# this value in the `x-admin-key` header. Leave empty to disable the reseed
# endpoint entirely.
ADMIN_API_KEY=